{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyticsManifest",
  "description": "Top-level analytics manifest that registers source stream tables as\nanalytical tables.",
  "type": "object",
  "properties": {
    "tables": {
      "description": "Table registrations to create and maintain in the analytical catalog.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TableRegistration"
      }
    },
    "version": {
      "description": "Manifest format version supported by this crate.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "tables"
  ],
  "$defs": {
    "AnalyticsColumn": {
      "description": "Analytical column definition.",
      "type": "object",
      "properties": {
        "column_name": {
          "description": "Output analytical column name. Must not be one of the built-in output\ncolumns: `tenant_id`, `table_name`, or `__id`.",
          "type": "string"
        },
        "column_type": {
          "description": "DuckDB-compatible column type.",
          "$ref": "#/$defs/AnalyticsColumnType"
        }
      },
      "required": [
        "column_name",
        "column_type"
      ]
    },
    "AnalyticsColumnType": {
      "description": "Logical analytics column type.",
      "oneOf": [
        {
          "description": "Scalar primitive value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "primitive"
            },
            "primitive": {
              "description": "Primitive scalar type.",
              "$ref": "#/$defs/PrimitiveColumnType"
            }
          },
          "required": [
            "kind",
            "primitive"
          ]
        },
        {
          "description": "List of primitive values.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "list"
            },
            "primitive": {
              "description": "Primitive list item type.",
              "$ref": "#/$defs/PrimitiveColumnType"
            }
          },
          "required": [
            "kind",
            "primitive"
          ]
        },
        {
          "description": "Map value stored as JSON in `DuckDB`.",
          "type": "object",
          "properties": {
            "key_type": {
              "description": "Logical key type documented for callers and stored as JSON.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "map"
            },
            "value_type": {
              "description": "Logical value type.",
              "$ref": "#/$defs/AnalyticsColumnType"
            }
          },
          "required": [
            "kind",
            "key_type",
            "value_type"
          ]
        }
      ]
    },
    "ClusteringKey": {
      "description": "`DuckLake` clustering or sorting key definition.",
      "type": "object",
      "properties": {
        "column_name": {
          "description": "Output column used for clustering.",
          "type": "string"
        },
        "order": {
          "description": "Sort direction. Defaults to ascending when omitted.",
          "anyOf": [
            {
              "$ref": "#/$defs/SortOrder"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "column_name"
      ]
    },
    "JoinPolicy": {
      "type": "object",
      "properties": {
        "allowed_as_join": {
          "type": "boolean",
          "default": false
        },
        "allowed_as_primary": {
          "type": "boolean",
          "default": true
        },
        "max_join_rows_hint": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "PartitionBucket": {
      "description": "Partition bucketing transform.",
      "oneOf": [
        {
          "description": "Hash bucket a column into a fixed number of buckets.",
          "type": "object",
          "properties": {
            "buckets": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "hash"
            }
          },
          "required": [
            "kind",
            "buckets"
          ]
        },
        {
          "description": "Time bucket a timestamp column.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "time"
            },
            "size": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "unit": {
              "$ref": "#/$defs/TimeBucketUnit"
            }
          },
          "required": [
            "kind",
            "unit",
            "size"
          ]
        }
      ]
    },
    "PartitionKey": {
      "description": "`DuckLake` partition key definition.",
      "type": "object",
      "properties": {
        "bucket": {
          "description": "Optional partition bucketing transform.",
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionBucket"
            },
            {
              "type": "null"
            }
          ]
        },
        "column_name": {
          "description": "Output column used for partitioning.",
          "type": "string"
        }
      },
      "required": [
        "column_name"
      ]
    },
    "PrimitiveColumnType": {
      "description": "Primitive `DuckDB` column type supported by the manifest contract.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "boolean",
            "var_char",
            "json",
            "big_int",
            "unsigned_big_int",
            "decimal",
            "double",
            "timestamp"
          ]
        },
        {
          "description": "Reversible tagged StorageValue JSON; numeric lexemes remain strings.",
          "type": "string",
          "const": "storage_json"
        }
      ]
    },
    "ProjectionColumn": {
      "description": "Typed projected column sourced from a nested source attribute path.",
      "type": "object",
      "properties": {
        "attribute_path": {
          "description": "Dot-separated source attribute path.",
          "type": "string"
        },
        "column_name": {
          "description": "Output analytical column name. Must not be one of the built-in output\ncolumns: `tenant_id`, `table_name`, or `__id`.",
          "type": "string"
        },
        "column_type": {
          "description": "Optional output column type. Omitted values use the VARCHAR type.",
          "anyOf": [
            {
              "$ref": "#/$defs/AnalyticsColumnType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "column_name",
        "attribute_path"
      ]
    },
    "RetentionPolicy": {
      "description": "Static retention policy for one analytical table.",
      "type": "object",
      "properties": {
        "period_ms": {
          "description": "Retention duration in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "timestamp": {
          "description": "Timestamp used as the start time for retention.",
          "$ref": "#/$defs/RetentionTimestamp"
        }
      },
      "required": [
        "period_ms",
        "timestamp"
      ]
    },
    "RetentionTimestamp": {
      "description": "Timestamp basis used to compute row expiry.",
      "oneOf": [
        {
          "description": "Read a unix epoch millisecond value from a source item attribute path.",
          "type": "object",
          "properties": {
            "attribute_path": {
              "description": "Dot-separated source attribute path.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute"
            }
          },
          "required": [
            "kind",
            "attribute_path"
          ]
        },
        {
          "description": "Use the aux-analytics ingestion time.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ingested_at"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "RowExpansion": {
      "description": "Manifest-controlled projection from a source list to analytical rows.",
      "type": "object",
      "properties": {
        "element_fields": {
          "description": "Fields copied from each list element into its expanded row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowProjectionField"
          }
        },
        "list_path": {
          "description": "Path from the source item to the list of row elements.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowPathSegment"
          }
        },
        "ordinal_attribute_name": {
          "description": "Optional output attribute populated with the zero-based list ordinal.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_fields": {
          "description": "Fields copied from the source item into every expanded row.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowProjectionField"
          }
        }
      },
      "required": [
        "list_path",
        "element_fields"
      ]
    },
    "RowIdentity": {
      "description": "Stable row identity extraction rule.",
      "oneOf": [
        {
          "description": "Use the record key supplied to the ingest endpoint.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "record_key"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Hash the source stream key map.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stream_keys"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Hash a string attribute value from the source item.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source string attribute containing row identity.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute"
            }
          },
          "required": [
            "kind",
            "attribute_name"
          ]
        },
        {
          "description": "Hash an ordered tuple of source attributes into one stable row id.\nThis is useful for expanded rows whose identity is a parent id plus\nlist ordinal.",
          "type": "object",
          "properties": {
            "attribute_names": {
              "description": "Ordered source attributes that together identify the row.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "attributes"
            }
          },
          "required": [
            "kind",
            "attribute_names"
          ]
        },
        {
          "description": "Extract row identity from a named regex capture group on a string\nattribute.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source string attribute to match.",
              "type": "string"
            },
            "capture": {
              "description": "Named capture group to use as row identity.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute_regex"
            },
            "regex": {
              "description": "Regular expression with the configured capture group.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "attribute_name",
            "regex",
            "capture"
          ]
        }
      ]
    },
    "RowPathSegment": {
      "description": "One typed segment in a source-item row-expansion path.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "attribute"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "index"
            }
          },
          "required": [
            "kind",
            "index"
          ]
        }
      ]
    },
    "RowProjectionField": {
      "description": "One field copied into an expanded source row.",
      "type": "object",
      "properties": {
        "output_attribute_name": {
          "description": "Attribute name presented to tenant, identity, retention, and column\nprojections after expansion.",
          "type": "string"
        },
        "path": {
          "description": "Path relative to the source item or current list element. An empty\nelement path copies the whole element; source paths must name an\nattribute.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RowPathSegment"
          }
        }
      },
      "required": [
        "output_attribute_name",
        "path"
      ]
    },
    "SortOrder": {
      "description": "Sort direction for clustering and structured order clauses.",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "StorageValue": {
      "description": "DynamoDB-compatible attribute value wire shape.",
      "oneOf": [
        {
          "description": "String scalar.",
          "type": "object",
          "properties": {
            "S": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "S"
          ]
        },
        {
          "description": "Number encoded as a string to preserve exact source representation.",
          "type": "object",
          "properties": {
            "N": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "N"
          ]
        },
        {
          "description": "Base64-encoded binary scalar.",
          "type": "object",
          "properties": {
            "B": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "B"
          ]
        },
        {
          "description": "String set.",
          "type": "object",
          "properties": {
            "SS": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "SS"
          ]
        },
        {
          "description": "Number set encoded as strings.",
          "type": "object",
          "properties": {
            "NS": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "NS"
          ]
        },
        {
          "description": "Binary set encoded as base64 strings.",
          "type": "object",
          "properties": {
            "BS": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "BS"
          ]
        },
        {
          "description": "Boolean scalar.",
          "type": "object",
          "properties": {
            "BOOL": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "BOOL"
          ]
        },
        {
          "description": "Null marker. Only true represents JSON null.",
          "type": "object",
          "properties": {
            "NULL": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "NULL"
          ]
        },
        {
          "description": "List attribute.",
          "type": "object",
          "properties": {
            "L": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StorageValue"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "L"
          ]
        },
        {
          "description": "Map attribute.",
          "type": "object",
          "properties": {
            "M": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/StorageValue"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "M"
          ]
        }
      ]
    },
    "TableRegistration": {
      "description": "Registration for one analytical table populated from one source table or\nsource table family.",
      "type": "object",
      "properties": {
        "analytics_table_name": {
          "description": "DuckDB-compatible analytical table name to create and query.",
          "type": "string"
        },
        "clustering_keys": {
          "description": "`DuckLake` clustering or sorting layout columns.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClusteringKey"
          }
        },
        "columns": {
          "description": "Explicit analytical columns. When present, these define table shape\ndirectly. Custom column names must not use the built-in output\ncolumn names `tenant_id`, `table_name`, or `__id`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalyticsColumn"
          }
        },
        "condition_expression": {
          "description": "Optional DynamoDB-compatible condition expression that filters source\nitems before ingestion.",
          "type": [
            "string",
            "null"
          ]
        },
        "document_column": {
          "description": "JSON document column containing the full source item. Set null for a\ndirect-ingestion table that source polling must not consume. Must not\nuse the built-in output column names `tenant_id`, `table_name`, or\n`__id`.",
          "type": [
            "string",
            "null"
          ],
          "default": "item"
        },
        "expression_attribute_names": {
          "description": "Expression attribute name aliases referenced by condition or projection\nexpressions.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "expression_attribute_values": {
          "description": "Expression attribute values referenced by condition or projection\nexpressions.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/StorageValue"
          }
        },
        "join_policy": {
          "description": "Join participation policy for bounded structured queries.",
          "$ref": "#/$defs/JoinPolicy",
          "default": {
            "allowed_as_join": false,
            "allowed_as_primary": true
          }
        },
        "partition_keys": {
          "description": "`DuckLake` partition layout columns.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartitionKey"
          }
        },
        "projection_attribute_names": {
          "description": "Simple top-level source attribute names to project as VARCHAR columns.\nValues must not use the built-in output column names `tenant_id`,\n`table_name`, or `__id`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "projection_columns": {
          "description": "Typed projection columns from nested source attributes.\nProjection output names must not use the built-in output column names\n`tenant_id`, `table_name`, or `__id`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ProjectionColumn"
          }
        },
        "retention": {
          "description": "Optional static retention policy for rows in this analytical table.",
          "anyOf": [
            {
              "$ref": "#/$defs/RetentionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_expansion": {
          "description": "Optional expansion that turns one source item containing a list into\none analytical source row per list element. Conditions are evaluated\nagainst the source item before expansion.",
          "anyOf": [
            {
              "$ref": "#/$defs/RowExpansion"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_identity": {
          "description": "Rule used to derive the stable row id for upserts and deletes.",
          "$ref": "#/$defs/RowIdentity",
          "default": {
            "kind": "record_key"
          }
        },
        "skip_delete": {
          "description": "Whether delete events should be ignored instead of removing analytical\nrows.",
          "type": "boolean",
          "default": false
        },
        "source_table_name": {
          "description": "Source storage table name to read from.",
          "type": "string"
        },
        "source_table_name_prefix": {
          "description": "Optional source table prefix for families of source tables that share\none registration.",
          "type": [
            "string",
            "null"
          ]
        },
        "table_scope": {
          "description": "Tenant/reference scope used by safe structured query planning.",
          "$ref": "#/$defs/TableScope",
          "default": {
            "kind": "tenant_scoped"
          }
        },
        "tenant_id": {
          "description": "Static tenant id to write into ingested rows when the source does not\ncarry tenant identity.",
          "type": [
            "string",
            "null"
          ]
        },
        "tenant_selector": {
          "description": "Rule used to derive tenant id from records when `tenant_id` is not\nstatic.",
          "$ref": "#/$defs/TenantSelector",
          "default": {
            "kind": "table_name"
          }
        }
      },
      "required": [
        "source_table_name",
        "analytics_table_name"
      ]
    },
    "TableScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tenant_scoped"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "global_reference"
            },
            "reference_class": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reference_class"
          ]
        }
      ]
    },
    "TenantSelector": {
      "description": "Tenant id extraction rule.",
      "oneOf": [
        {
          "description": "Do not write tenant ids.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Use the source table name as tenant context.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "table_name"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Read tenant id from a string attribute.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source string attribute containing tenant id.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute"
            }
          },
          "required": [
            "kind",
            "attribute_name"
          ]
        },
        {
          "description": "Extract tenant id from a named regex capture group on a string\nattribute.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source string attribute to match.",
              "type": "string"
            },
            "capture": {
              "description": "Named capture group to use as tenant id.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute_regex"
            },
            "regex": {
              "description": "Regular expression with the configured capture group.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "attribute_name",
            "regex",
            "capture"
          ]
        },
        {
          "description": "Prefer table name when available, otherwise parse a partition-key\nprefix.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source partition key attribute.",
              "type": "string",
              "default": "pk"
            },
            "kind": {
              "type": "string",
              "const": "table_name_or_partition_key_prefix"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Parse tenant id from the prefix of a partition key attribute.",
          "type": "object",
          "properties": {
            "attribute_name": {
              "description": "Source partition key attribute.",
              "type": "string",
              "default": "pk"
            },
            "kind": {
              "type": "string",
              "const": "partition_key_prefix"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "TimeBucketUnit": {
      "description": "Time bucket unit for partitioning.",
      "type": "string",
      "enum": [
        "minute",
        "hour",
        "day",
        "month"
      ]
    }
  }
}
